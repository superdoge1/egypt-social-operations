---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressPanel from '../components/ProgressPanel.astro';
import LessonCard from '../components/LessonCard.astro';
import { validateLessonGraph, validateQuizCoverage } from '../lib/content-graph';
import { quizzes } from '../data/quizzes';
import { withBase } from '../lib/urls';
const lessons=(await getCollection('lessons')).sort((a,b)=>a.data.order-b.data.order);
const curriculum=lessons.map(({data})=>({id:data.id,order:data.order,prerequisites:data.prerequisites}));
const graphErrors=[...validateLessonGraph(curriculum),...validateQuizCoverage(curriculum, quizzes)];
if(graphErrors.length) throw new Error(`Invalid curriculum:\n${graphErrors.join('\n')}`);
const lessonIds=lessons.map(({data})=>data.id);
---
<BaseLayout title="埃及社交运营 Fieldbook"><div class="page-shell home-shell">
  <section class="environment-strip" aria-label="构建环境状态" data-entrance>
    <p class="environment-ready"><i aria-hidden="true"></i><strong>ENVIRONMENT READY</strong></p>
    <dl>
      <div><dt>CURRICULUM</dt><dd>{lessonIds.length} MODULES</dd></div>
      <div><dt>STATE</dt><dd>LOCAL-FIRST</dd></div>
      <div><dt>PATH</dt><dd>GLOBAL → EGYPT → SUGO</dd></div>
    </dl>
  </section>
  <section class="hero" data-entrance><div class="hero-statement"><span class="eyebrow">EGYPT SOCIAL OPERATIONS · 11 MODULES</span><h1>先做出来。<span>再做可靠。</span></h1><p class="hero-copy">一条从全球社交娱乐类别，到埃及 SUGO 客户运营的公开证据学习路径。每一节都留下可验证的产出，而不是只收藏结论。</p><div class="hero-actions"><a class="button" href={withBase(`learn/${lessonIds[0]}/`)}>开始第一次构建</a><a class="button secondary" href={withBase('roadmap/')}>查看完整路线</a></div></div>
  <div class="terminal" aria-label="课程执行轨迹"><div class="terminal-bar"><span>learning-pipeline.log</span><span class="terminal-local"><i aria-hidden="true"></i> LOCAL</span></div><pre><span class="info">[01]</span> idea → validated problem
<span class="info">[02]</span> prompt → working prototype
<span class="ok">[03]</span> prototype → deployed product

<span class="agent">[AGENT]</span> context indexed
<span class="agent">[AGENT]</span> spec accepted
<span class="agent">[AGENT]</span> tests observed red → green
<span class="ok">[SHIP]</span> evidence attached_</pre></div></section>
  <ProgressPanel lessonIds={lessonIds} storageKey="egyptSocialOperationsProgress.v1" />
  <section class="build-trace" data-entrance><div class="section-heading"><h2>运营学习轨迹</h2><p>11 节课程从全球类别、SUGO 用户旅程与埃及市场出发，逐步形成可交接的证据包。</p></div><div class="trace">{lessons.map(({data})=><LessonCard {...data}/>)}</div></section>
</div></BaseLayout>
