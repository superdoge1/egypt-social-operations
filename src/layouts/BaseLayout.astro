---
import '../styles/global.css';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = '面向埃及 SUGO 客户运营的公开证据学习场。', noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageTitle = `${title} · Egypt Social Operations Fieldbook`;
const nav = [
  { href: withBase(''), label: '起点' },
  { href: withBase('roadmap/'), label: '学习路线' },
  { href: withBase('projects/'), label: '项目' },
  { href: withBase('resources/'), label: '资料台' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Egypt Social Operations Fieldbook" />
    <meta property="og:locale" content="zh_CN" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body data-interface="cairo-signal-atlas">
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header" data-entrance>
      <a class="brand" href={withBase('')} aria-label="Egypt Social Operations 首页">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 36 36" role="img"><path d="M5 6h26M5 12h18M5 18h26M5 24h13M5 30h26" /></svg></span>
        <span><strong>CAIRO SIGNAL ATLAS</strong><small>EGYPT SOCIAL OPERATIONS · PUBLIC FIELD BOOK</small></span>
      </a>
      <div class="header-tools">
        <span class="header-status"><i aria-hidden="true"></i> PUBLIC / UNOFFICIAL</span>
        <nav aria-label="主导航">
          {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <p>把每一次阅读、请求和访谈，都留下可复核的证据痕迹。</p>
      <p class="footer-disclaimer">非官方教育资源；不构成法律、税务、隐私、雇佣或监管建议。公开来源与原创模板不包含内部资料。</p>
      <p class="mono">OPEN FIELD BOOK · LOCAL-FIRST PROGRESS · 2026</p>
    </footer>
  </body>
</html>
